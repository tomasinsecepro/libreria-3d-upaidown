{
  "name": "libreria-3d-upaidown",
  "version": "1.1.0",
  "description": "Librería 3D interactiva y procedural con modelos agrícolas, fauna ibérica, fotovoltaica y riego para Three.js y React Three Fiber",
  "main": "./extracted-3d-lib/index.ts",
  "module": "./extracted-3d-lib/index.ts",
  "types": "./extracted-3d-lib/index.ts",
  "exports": {
    ".": "./extracted-3d-lib/index.ts",
    "./components/*": "./extracted-3d-lib/components/*",
    "./models/*": "./extracted-3d-lib/models/*"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node viewer-server.mjs",
    "viewer": "node viewer-server.mjs",
    "build:models": "node extracted-3d-lib/scripts/build-models.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "^3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
